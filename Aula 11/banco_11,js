// ==============================
// FUNÇÃO DE SAQUE
// ==============================

function sacar(valor) {

    // Verifica se o valor é positivo
    // e se existe saldo suficiente.
    if (valor > 0 && valor <= saldo) {

        // Subtrai o valor do saldo.
        saldo -= valor;

        // Exibe mensagem de sucesso.
        console.log(`\nSaque de R$ ${valor.toFixed(2)} realizado com sucesso!\nNovo saldo: R$ ${valor.toFixed(2)}`);

        // Registra o saque no histórico.
        historico.push(`Saque: R$ ${valor} | Saldo: R$ ${saldo}`);

    } else {

        // Exibe mensagem caso o saque seja inválido.
        console.log("\nValor de saque invalido. o Valor deve ser maior que maior que zero e menor ou igual ao saldo");

    }

}


// ==============================
// FUNÇÃO RESUMO DAS TRANSAÇÕES
// ==============================

function verResumo() {

    // Contador de depósitos.
    let nDepositos = 0;

    // Contador de saques.
    let nSaques = 0;

    // Contador total de transações.
    let qtdTransações = 0;

    // Percorre todas as posições do histórico.
    for (let i = 0; i < historico.length; i++) {

        // Verifica se a transação contém a palavra "Deposito".
        if (historico[i].includes("Deposito")) {

            // Soma um depósito.
            nDepositos++;

        } else {

            // Caso contrário, considera um saque.
            nSaques++;

        }

        // Soma uma transação ao total.
        qtdTransações++;

    }

    // Exibe o título do resumo.
    console.log("\n =====Resumo de Transações=====");

    // Exibe a quantidade de depósitos.
    console.log(` Depositos: ${nDepositos}`);

    // Exibe a quantidade de saques.
    console.log(` Saques: ${nSaques}`);

    // Exibe o total de operações.
    console.log(` Total: ${qtdTransações}`);

}


// ==============================
// FUNÇÃO PARA SIMULAR SAQUES
// ==============================

function simularTentativasSaque(valor, maxTentativas = 5) {

    // Contador de tentativas.
    let tentativas = 0;

    // Executa enquanto houver tentativas
    // e o valor for maior que o saldo.
    while (tentativas < maxTentativas && valor > saldo) {

        // Exibe a tentativa atual.
        console.log(`🔄 Tentativa ${tentativas + 1}: R$ ${valor.toFixed(2)} — saldo insuficiente`);

        // Reduz o valor do saque em 20%.
        valor = valor * 0.8;

        // Incrementa o contador.
        tentativas++;

    }

    // Se atingir o limite de tentativas.
    if (tentativas === maxTentativas) {

        // Informa que o saque não foi realizado.
        console.log("❌ Tentativas esgotadas. Saque não realizado.");

    } else {

        // Caso exista saldo suficiente, realiza o saque.
        sacar(valor);

    }

}


// ==============================
// EXECUÇÃO DO PROGRAMA
// ==============================

// Deposita R$ 1000.
depositar(1000);

// Deposita R$ 200.
depositar(200);

// Deposita R$ 300.
depositar(300);

// Realiza um saque de R$ 247.
sacar(247);

// Realiza um saque de R$ 200.
sacar(200);

// Simula um saque iniciando em R$ 5000
// com no máximo 4 tentativas.
simularTentativasSaque(5000, 4);

// Exibe todo o histórico armazenado no array.
console.log(historico);

// Mostra o extrato completo.
verExtrato();

// Mostra o resumo das transações.
verResumo();