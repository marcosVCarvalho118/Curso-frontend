// ==============================
// VARIÁVEIS DO SISTEMA
// ==============================

// Constante que armazena o número da conta.
// Como é "const", seu valor não pode ser alterado.
const numeroConta = 1;

// Variável que armazena o nome do titular da conta.
let titular = "Marcos";

// Variável que armazena o saldo atual da conta.
let saldo = 1000;

// Variável booleana que informa se a conta está ativa.
// true = conta ativa
// false = conta bloqueada
let contaAtiva = true;

// Variável que armazenará o status da conta.
let statusConta;

// Array utilizado para guardar o histórico das transações.
const historico = [];


// ==============================
// FUNÇÃO PARA EXIBIR O EXTRATO
// ==============================

function verExtrato() {

    // Verifica se a conta está ativa.
    if (contaAtiva) {

        // Se estiver ativa, define o status como "Ativa".
        statusConta = "Ativa";

    } else {

        // Caso contrário, define o status como "Bloqueado".
        statusConta = "Bloqueado";

    }

    // Exibe o nome do banco.
    console.log("======Banco InovaBank===== ");

    // Exibe o número da conta.
    console.log(`Conta: ${numeroConta}`);

    // Exibe o nome do titular.
    console.log(`Titular: ${titular}`);

    // Exibe o saldo com duas casas decimais.
    console.log(`Saldo: R$ ${saldo.toFixed(2)}`);

    // Exibe o status da conta.
    console.log(`Status: ${statusConta}`);

    // Percorre as cinco últimas posições do histórico.
    for (let i = 1; i < 6; i++) {

        // Calcula o índice da transação mais recente.
        const indiceAtual = historico.length - i;

        // Exibe cada transação armazenada.
        console.log(`${i}. ${historico[indiceAtual]}`);
    }

}


// ==============================
// FUNÇÃO DE DEPÓSITO
// ==============================

function depositar(valor) {

    // Verifica se o valor informado é maior que zero.
    if (valor > 0) {

        // Soma o valor ao saldo atual.
        saldo = saldo + valor;

        // Exibe mensagem informando o depósito.
        console.log(`\ndeposito de R$ ${valor.toFixed(2)} realizado com sucesso!`);

        // Exibe o novo saldo.
        console.log(`Novo saldo:R$ ${saldo.toFixed(2)}`);

        // Adiciona a operação ao histórico.
        historico.push(`Deposito: R$ ${valor} | Saldo: R$ ${saldo}`);

    } else {

        // Caso o valor seja inválido.
        console.log("\nValor de deposito invalido, o valor deve ser maior que zero.");

    }

}


